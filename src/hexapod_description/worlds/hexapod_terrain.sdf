<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hexapod_terrain">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Flat Ground Plane (Revêtement laboratoire caoutchouteux : mu = 0.85) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.85</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 1. CHEMIN AVANT EXISTANT (y = 0.0 m, le long de +X)                   -->
    <!-- ===================================================================== -->

    <!-- Low Step / Obstacle: +20 mm high (x = +0.8m) -->
    <model name="obstacle_step_20mm">
      <static>true</static>
      <pose>0.8 0.0 0.010 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.80 0.020</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.85</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.80 0.020</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.2 1</ambient>
            <diffuse>0.9 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Trench / Step Down: 20 mm drop simulation (x = +1.5m) -->
    <model name="depression_ditch_20mm">
      <static>true</static>
      <pose>1.5 0.0 0.0125 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.50 0.80 0.025</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.85</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.50 0.80 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.2 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inclined Ramp (x = 1.15m) -->
    <model name="plateau_access_ramp">
      <static>true</static>
      <pose>1.15 0.0 0.002 -0.10 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.80 0.020</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.85</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 0.80 0.020</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.2 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 2. PISTE DE REVÊTEMENTS À DROITE (y = -1.30 m, de x = 0.50 à 5.00 m)  -->
    <!-- ===================================================================== -->

    <!-- Zone A : Terre compactée (Marron, mu = 0.55, longueur 1.50 m) -->
    <model name="terrain_strip_dirt">
      <static>true</static>
      <pose>1.25 -1.30 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.50 1.00 0.002</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.55</mu>
                <mu2>0.55</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.50 1.00 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.36 0.22 0.11 1</ambient>
            <diffuse>0.42 0.26 0.13 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Zone B : Carrelage lisse (Blanc avec quadrillage visuel, mu = 0.25, longueur 1.50 m) -->
    <model name="terrain_strip_tile">
      <static>true</static>
      <pose>2.75 -1.30 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.50 1.00 0.002</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.25</mu>
                <mu2>0.25</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.50 1.00 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.94 0.96 1</ambient>
            <diffuse>0.95 0.97 0.99 1</diffuse>
            <specular>0.85 0.85 0.90 1</specular>
          </material>
        </visual>
        <!-- Joints visuels pour apprécier visuellement le glissement -->
        <visual name="joint_x1">
          <pose>-0.375 0 0.0011 0 0 0</pose>
          <geometry><box><size>0.008 1.00 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_x2">
          <pose>0.0 0 0.0011 0 0 0</pose>
          <geometry><box><size>0.008 1.00 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_x3">
          <pose>0.375 0 0.0011 0 0 0</pose>
          <geometry><box><size>0.008 1.00 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_y1">
          <pose>0 -0.25 0.0011 0 0 0</pose>
          <geometry><box><size>1.50 0.008 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_y2">
          <pose>0 0.25 0.0011 0 0 0</pose>
          <geometry><box><size>1.50 0.008 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Zone C : Goudron / Bitume (Noir, mu = 0.70, longueur 1.50 m) -->
    <model name="terrain_strip_asphalt">
      <static>true</static>
      <pose>4.25 -1.30 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.50 1.00 0.002</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.70</mu>
                <mu2>0.70</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.50 1.00 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.15 0.15 0.16 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 3. PARCOURS D'EMBÛCHES AVANCÉ À GAUCHE (y = +1.45 m, x = 0.40 -> 8.0) -->
    <!-- ===================================================================== -->

    <!-- EMBÛCHE 1 : Dévers latéral (Roll ~8°) avec rampes d'accès/sortie -->
    <model name="left_course_roll_slope">
      <static>true</static>
      <link name="link">
        <!-- Rampe d'accès -->
        <collision name="entry_ramp_col">
          <pose>0.575 1.45 0.028 0 -0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="entry_ramp_vis">
          <pose>0.575 1.45 0.028 0 -0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <material><ambient>0.25 0.55 0.45 1</ambient><diffuse>0.30 0.65 0.52 1</diffuse></material>
        </visual>

        <!-- Tablier en dévers latéral (roulis 0.14 rad ~ 8 deg) -->
        <collision name="banked_deck_col">
          <pose>1.30 1.45 0.055 0.14 0 0</pose>
          <geometry><box><size>1.10 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="banked_deck_vis">
          <pose>1.30 1.45 0.055 0.14 0 0</pose>
          <geometry><box><size>1.10 0.90 0.020</size></box></geometry>
          <material><ambient>0.20 0.48 0.38 1</ambient><diffuse>0.25 0.58 0.45 1</diffuse></material>
        </visual>

        <!-- Rampe de sortie -->
        <collision name="exit_ramp_col">
          <pose>2.025 1.45 0.028 0 0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="exit_ramp_vis">
          <pose>2.025 1.45 0.028 0 0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <material><ambient>0.25 0.55 0.45 1</ambient><diffuse>0.30 0.65 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- EMBÛCHE 2 : Escalier 3 marches montantes & descendantes (15 -> 30 -> 42 -> 20 mm) -->
    <model name="left_course_stairs">
      <static>true</static>
      <link name="link">
        <collision name="step1_col">
          <pose>2.625 1.45 0.0075 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.015</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="step1_vis">
          <pose>2.625 1.45 0.0075 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.015</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.90 0.60 0.20 1</diffuse></material>
        </visual>

        <collision name="step2_col">
          <pose>2.875 1.45 0.015 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.030</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="step2_vis">
          <pose>2.875 1.45 0.015 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.030</size></box></geometry>
          <material><ambient>0.80 0.45 0.12 1</ambient><diffuse>0.85 0.50 0.15 1</diffuse></material>
        </visual>

        <collision name="step3_top_col">
          <pose>3.15 1.45 0.021 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.042</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="step3_top_vis">
          <pose>3.15 1.45 0.021 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.042</size></box></geometry>
          <material><ambient>0.75 0.35 0.10 1</ambient><diffuse>0.80 0.40 0.12 1</diffuse></material>
        </visual>

        <collision name="step4_down_col">
          <pose>3.425 1.45 0.010 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="step4_down_vis">
          <pose>3.425 1.45 0.010 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.020</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.90 0.60 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- EMBÛCHE 3 : Champ de plots asymétriques / Stepping stones (14 à 30 mm) -->
    <model name="left_course_stepping_stones">
      <static>true</static>
      <link name="link">
        <!-- Plot 1 (droite, 16 mm) -->
        <collision name="stone1_col">
          <pose>3.95 1.25 0.008 0 0 0.15</pose>
          <geometry><box><size>0.24 0.34 0.016</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="stone1_vis">
          <pose>3.95 1.25 0.008 0 0 0.15</pose>
          <geometry><box><size>0.24 0.34 0.016</size></box></geometry>
          <material><ambient>0.45 0.45 0.50 1</ambient><diffuse>0.55 0.55 0.60 1</diffuse></material>
        </visual>

        <!-- Plot 2 (gauche, 26 mm) -->
        <collision name="stone2_col">
          <pose>4.15 1.65 0.013 0 0 -0.20</pose>
          <geometry><box><size>0.24 0.34 0.026</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="stone2_vis">
          <pose>4.15 1.65 0.013 0 0 -0.20</pose>
          <geometry><box><size>0.24 0.34 0.026</size></box></geometry>
          <material><ambient>0.38 0.38 0.42 1</ambient><diffuse>0.48 0.48 0.52 1</diffuse></material>
        </visual>

        <!-- Plot 3 (centre-droite, 30 mm) -->
        <collision name="stone3_col">
          <pose>4.42 1.30 0.015 0 0 0.05</pose>
          <geometry><box><size>0.22 0.32 0.030</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="stone3_vis">
          <pose>4.42 1.30 0.015 0 0 0.05</pose>
          <geometry><box><size>0.22 0.32 0.030</size></box></geometry>
          <material><ambient>0.32 0.32 0.36 1</ambient><diffuse>0.42 0.42 0.46 1</diffuse></material>
        </visual>

        <!-- Plot 4 (gauche, 14 mm) -->
        <collision name="stone4_col">
          <pose>4.65 1.68 0.007 0 0 0.25</pose>
          <geometry><box><size>0.25 0.34 0.014</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="stone4_vis">
          <pose>4.65 1.68 0.007 0 0 0.25</pose>
          <geometry><box><size>0.25 0.34 0.014</size></box></geometry>
          <material><ambient>0.48 0.48 0.52 1</ambient><diffuse>0.58 0.58 0.62 1</diffuse></material>
        </visual>

        <!-- Plot 5 (droite, 22 mm) -->
        <collision name="stone5_col">
          <pose>4.92 1.24 0.011 0 0 -0.10</pose>
          <geometry><box><size>0.26 0.35 0.022</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="stone5_vis">
          <pose>4.92 1.24 0.011 0 0 -0.10</pose>
          <geometry><box><size>0.26 0.35 0.022</size></box></geometry>
          <material><ambient>0.40 0.40 0.45 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- EMBÛCHE 4 : Double fosse asymétrique en chicane (trous de 65 mm) -->
    <model name="left_course_chicane_ditches">
      <static>true</static>
      <link name="link">
        <!-- Dalle d'entrée (hauteur 25 mm) -->
        <collision name="entry_pad_col">
          <pose>5.60 1.45 0.0125 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.025</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="entry_pad_vis">
          <pose>5.60 1.45 0.0125 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <!-- Pont côté droit uniquement (fosse de 65 mm à gauche en x = 5.78) -->
        <collision name="right_bridge_col">
          <pose>5.80 1.225 0.0125 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.025</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="right_bridge_vis">
          <pose>5.80 1.225 0.0125 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <!-- Îlot central -->
        <collision name="mid_pad_col">
          <pose>5.98 1.45 0.0125 0 0 0</pose>
          <geometry><box><size>0.26 0.90 0.025</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="mid_pad_vis">
          <pose>5.98 1.45 0.0125 0 0 0</pose>
          <geometry><box><size>0.26 0.90 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <!-- Pont côté gauche uniquement (fosse de 65 mm à droite en x = 6.15) -->
        <collision name="left_bridge_col">
          <pose>6.16 1.675 0.0125 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.025</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="left_bridge_vis">
          <pose>6.16 1.675 0.0125 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <!-- Dalle de sortie -->
        <collision name="exit_pad_col">
          <pose>6.35 1.45 0.0125 0 0 0</pose>
          <geometry><box><size>0.28 0.90 0.025</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="exit_pad_vis">
          <pose>6.35 1.45 0.0125 0 0 0</pose>
          <geometry><box><size>0.28 0.90 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- EMBÛCHE 5 : Poutre étroite surélevée (largeur 38 cm < voie du robot) -->
    <model name="left_course_narrow_beam">
      <static>true</static>
      <link name="link">
        <!-- Marche d'accès -->
        <collision name="beam_entry_col">
          <pose>6.85 1.45 0.006 0 0 0</pose>
          <geometry><box><size>0.16 0.50 0.012</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="beam_entry_vis">
          <pose>6.85 1.45 0.006 0 0 0</pose>
          <geometry><box><size>0.16 0.50 0.012</size></box></geometry>
          <material><ambient>0.75 0.18 0.22 1</ambient><diffuse>0.85 0.22 0.26 1</diffuse></material>
        </visual>

        <!-- Poutre centrale étroite (0.38 m de large, 1.10 m de long, 25 mm de haut) -->

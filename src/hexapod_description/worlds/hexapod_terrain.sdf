<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hexapod_terrain">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Base Ground Plane (Rubberized laboratory flooring: mu = 0.85) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.85</mu>
                <mu2>0.85</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 1. CENTRAL TECHNICAL COURSE (y = 0.0 m, x = 0.90 -> 8.70 m)           -->
    <!-- ===================================================================== -->

    <!-- OBSTACLE 1: Lateral Banked Slope (Roll ~8 deg) with entry/exit ramps -->
    <model name="center_course_roll_slope">
      <static>true</static>
      <link name="link">
        <!-- Entry ramp -->
        <collision name="entry_ramp_col">
          <pose>1.075 0 0.028 0 -0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="entry_ramp_vis">
          <pose>1.075 0 0.028 0 -0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <material><ambient>0.25 0.55 0.45 1</ambient><diffuse>0.30 0.65 0.52 1</diffuse></material>
        </visual>

        <!-- Banked deck (roll 0.14 rad ~ 8 deg) -->
        <collision name="banked_deck_col">
          <pose>1.80 0 0.055 0.14 0 0</pose>
          <geometry><box><size>1.10 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="banked_deck_vis">
          <pose>1.80 0 0.055 0.14 0 0</pose>
          <geometry><box><size>1.10 0.90 0.020</size></box></geometry>
          <material><ambient>0.20 0.48 0.38 1</ambient><diffuse>0.25 0.58 0.45 1</diffuse></material>
        </visual>

        <!-- Exit ramp -->
        <collision name="exit_ramp_col">
          <pose>2.525 0 0.028 0 0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <surface><friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction></surface>
        </collision>
        <visual name="exit_ramp_vis">
          <pose>2.525 0 0.028 0 0.153 0</pose>
          <geometry><box><size>0.36 0.90 0.020</size></box></geometry>
          <material><ambient>0.25 0.55 0.45 1</ambient><diffuse>0.30 0.65 0.52 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OBSTACLE 2: 3-Step Ascending & Descending Stairs (15 -> 30 -> 42 -> 20 mm) -->
    <model name="center_course_stairs">
      <static>true</static>
      <link name="link">
        <collision name="step1_col">
          <pose>3.125 0.0 -0.0025 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.035</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="step1_vis">
          <pose>3.125 0.0 0.0075 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.015</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.90 0.60 0.20 1</diffuse></material>
        </visual>

        <collision name="step2_col">
          <pose>3.375 0.0 0.005 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.050</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="step2_vis">
          <pose>3.375 0.0 0.015 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.030</size></box></geometry>
          <material><ambient>0.80 0.45 0.12 1</ambient><diffuse>0.85 0.50 0.15 1</diffuse></material>
        </visual>

        <collision name="step3_top_col">
          <pose>3.65 0.0 0.011 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.062</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="step3_top_vis">
          <pose>3.65 0.0 0.021 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.042</size></box></geometry>
          <material><ambient>0.75 0.35 0.10 1</ambient><diffuse>0.80 0.40 0.12 1</diffuse></material>
        </visual>

        <collision name="step4_down_col">
          <pose>3.925 0.0 0.0 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="step4_down_vis">
          <pose>3.925 0.0 0.010 0 0 0</pose>
          <geometry><box><size>0.25 0.90 0.020</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.90 0.60 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OBSTACLE 3: Asymmetric Stepping Stones Field (14 to 30 mm) -->
    <model name="center_course_stepping_stones">
      <static>true</static>
      <link name="link">
        <collision name="stone1_col">
          <pose>4.45 -0.20 -0.002 0 0 0.15</pose>
          <geometry><box><size>0.24 0.34 0.036</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="stone1_vis">
          <pose>4.45 -0.20 0.008 0 0 0.15</pose>
          <geometry><box><size>0.24 0.34 0.016</size></box></geometry>
          <material><ambient>0.45 0.45 0.50 1</ambient><diffuse>0.55 0.55 0.60 1</diffuse></material>
        </visual>

        <collision name="stone2_col">
          <pose>4.65 0.20 0.003 0 0 -0.20</pose>
          <geometry><box><size>0.24 0.34 0.046</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="stone2_vis">
          <pose>4.65 0.20 0.013 0 0 -0.20</pose>
          <geometry><box><size>0.24 0.34 0.026</size></box></geometry>
          <material><ambient>0.38 0.38 0.42 1</ambient><diffuse>0.48 0.48 0.52 1</diffuse></material>
        </visual>

        <collision name="stone3_col">
          <pose>4.92 -0.15 0.005 0 0 0.05</pose>
          <geometry><box><size>0.22 0.32 0.050</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="stone3_vis">
          <pose>4.92 -0.15 0.015 0 0 0.05</pose>
          <geometry><box><size>0.22 0.32 0.030</size></box></geometry>
          <material><ambient>0.32 0.32 0.36 1</ambient><diffuse>0.42 0.42 0.46 1</diffuse></material>
        </visual>

        <collision name="stone4_col">
          <pose>5.15 0.23 -0.003 0 0 0.25</pose>
          <geometry><box><size>0.25 0.34 0.034</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="stone4_vis">
          <pose>5.15 0.23 0.007 0 0 0.25</pose>
          <geometry><box><size>0.25 0.34 0.014</size></box></geometry>
          <material><ambient>0.48 0.48 0.52 1</ambient><diffuse>0.58 0.58 0.62 1</diffuse></material>
        </visual>

        <collision name="stone5_col">
          <pose>5.42 -0.21 0.001 0 0 -0.10</pose>
          <geometry><box><size>0.26 0.35 0.042</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="stone5_vis">
          <pose>5.42 -0.21 0.011 0 0 -0.10</pose>
          <geometry><box><size>0.26 0.35 0.022</size></box></geometry>
          <material><ambient>0.40 0.40 0.45 1</ambient><diffuse>0.50 0.50 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OBSTACLE 4: Asymmetric Chicane Double Ditches (ground-anchored pads) -->
    <model name="center_course_chicane_ditches">
      <static>true</static>
      <link name="link">
        <collision name="entry_pad_col">
          <pose>6.10 0.0 0.0025 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.045</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="entry_pad_vis">
          <pose>6.10 0.0 0.0125 0 0 0</pose>
          <geometry><box><size>0.30 0.90 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <collision name="right_bridge_col">
          <pose>6.30 -0.225 0.0025 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.045</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="right_bridge_vis">
          <pose>6.30 -0.225 0.0125 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <collision name="mid_pad_col">
          <pose>6.48 0.0 0.0025 0 0 0</pose>
          <geometry><box><size>0.26 0.90 0.045</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="mid_pad_vis">
          <pose>6.48 0.0 0.0125 0 0 0</pose>
          <geometry><box><size>0.26 0.90 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <collision name="left_bridge_col">
          <pose>6.66 0.225 0.0025 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.045</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="left_bridge_vis">
          <pose>6.66 0.225 0.0125 0 0 0</pose>
          <geometry><box><size>0.12 0.45 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>

        <collision name="exit_pad_col">
          <pose>6.85 0.0 0.0025 0 0 0</pose>
          <geometry><box><size>0.28 0.90 0.045</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="exit_pad_vis">
          <pose>6.85 0.0 0.0125 0 0 0</pose>
          <geometry><box><size>0.28 0.90 0.025</size></box></geometry>
          <material><ambient>0.55 0.25 0.55 1</ambient><diffuse>0.65 0.32 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OBSTACLE 5: Elevated Narrow Beam (38 cm width < robot track width) -->
    <model name="center_course_narrow_beam">
      <static>true</static>
      <link name="link">
        <collision name="beam_entry_col">
          <pose>7.35 0.0 -0.004 0 0 0</pose>
          <geometry><box><size>0.16 0.50 0.032</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="beam_entry_vis">
          <pose>7.35 0.0 0.006 0 0 0</pose>
          <geometry><box><size>0.16 0.50 0.012</size></box></geometry>
          <material><ambient>0.75 0.18 0.22 1</ambient><diffuse>0.85 0.22 0.26 1</diffuse></material>
        </visual>

        <collision name="beam_main_col">
          <pose>7.98 0.0 0.0025 0 0 0</pose>
          <geometry><box><size>1.10 0.38 0.045</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="beam_main_vis">
          <pose>7.98 0.0 0.0125 0 0 0</pose>
          <geometry><box><size>1.10 0.38 0.025</size></box></geometry>
          <material><ambient>0.68 0.14 0.18 1</ambient><diffuse>0.78 0.18 0.22 1</diffuse></material>
        </visual>

        <collision name="beam_exit_col">
          <pose>8.61 0.0 -0.004 0 0 0</pose>
          <geometry><box><size>0.16 0.50 0.032</size></box></geometry>
          <surface>
            <friction><ode><mu>0.85</mu><mu2>0.85</mu2></ode></friction>
            <contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel></ode></contact>
          </surface>
        </collision>
        <visual name="beam_exit_vis">
          <pose>8.61 0.0 0.006 0 0 0</pose>
          <geometry><box><size>0.16 0.50 0.012</size></box></geometry>
          <material><ambient>0.75 0.18 0.22 1</ambient><diffuse>0.85 0.22 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 2. SURFACE FRICTION TRACK ON RIGHT (y = -1.35 m, x = 0.50 to 5.00 m)  -->
    <!-- ===================================================================== -->

    <!-- Zone A: Compacted Dirt (Brown, mu = 0.55) -->
    <model name="terrain_strip_dirt">
      <static>true</static>
      <pose>1.25 -1.35 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.50 1.00 0.002</size></box></geometry>
          <surface><friction><ode><mu>0.55</mu><mu2>0.55</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.50 1.00 0.002</size></box></geometry>
          <material><ambient>0.36 0.22 0.11 1</ambient><diffuse>0.42 0.26 0.13 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Zone B: Smooth Tile (White grid, mu = 0.25) -->
    <model name="terrain_strip_tile">
      <static>true</static>
      <pose>2.75 -1.35 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.50 1.00 0.002</size></box></geometry>
          <surface><friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.50 1.00 0.002</size></box></geometry>
          <material><ambient>0.92 0.94 0.96 1</ambient><diffuse>0.95 0.97 0.99 1</diffuse><specular>0.85 0.85 0.90 1</specular></material>
        </visual>
        <visual name="joint_x1">
          <pose>-0.375 0 0.0011 0 0 0</pose>
          <geometry><box><size>0.008 1.00 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_x2">
          <pose>0.0 0 0.0011 0 0 0</pose>
          <geometry><box><size>0.008 1.00 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_x3">
          <pose>0.375 0 0.0011 0 0 0</pose>
          <geometry><box><size>0.008 1.00 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_y1">
          <pose>0 -0.25 0.0011 0 0 0</pose>
          <geometry><box><size>1.50 0.008 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        <visual name="joint_y2">
          <pose>0 0.25 0.0011 0 0 0</pose>
          <geometry><box><size>1.50 0.008 0.0002</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Zone C: Asphalt / Tarmac (Black, mu = 0.70) -->
    <model name="terrain_strip_asphalt">
      <static>true</static>
      <pose>4.25 -1.35 0.001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.50 1.00 0.002</size></box></geometry>
          <surface><friction><ode><mu>0.70</mu><mu2>0.70</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.50 1.00 0.002</size></box></geometry>
          <material><ambient>0.12 0.12 0.13 1</ambient><diffuse>0.15 0.15 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================================================================== -->
    <!-- 3. CHAOTIC FOREST UNDERGROWTH ON LEFT (y = +1.65 m, x = 0.45 -> 8.10) -->
    <!--    Optimized collisions (visual-only leaves, no coplanar ground layer)-->
    <!-- ===================================================================== -->

    <!-- 3A. BASE HUMUS & UNDULATING TERRAIN (combined roll/pitch slopes, mu = 0.44) -->
    <model name="forest_undulating_soil">
      <static>true</static>
      <link name="link">
        <!-- Forest humus bed (visual only; ground_plane handles contact) -->
        <visual name="humus_bed_vis">
          <pose>4.25 1.65 0.0015 0 0 0</pose>
          <geometry><box><size>7.70 1.35 0.003</size></box></geometry>
          <material><ambient>0.24 0.16 0.09 1</ambient><diffuse>0.30 0.20 0.11 1</diffuse></material>
        </visual>

        <!-- Oblique mound 1 (uphill pitch + left bank) -->
        <collision name="mound_1_col">
          <pose>1.05 1.48 0.006 0.08 -0.06 0.35</pose>
          <geometry><box><size>0.95 0.72 0.028</size></box></geometry>
          <surface><friction><ode><mu>0.44</mu><mu2>0.44</mu2></ode></friction></surface>

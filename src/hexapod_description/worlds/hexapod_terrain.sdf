<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hexapod_terrain">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Flat Ground Plane (Nominal Starting & Turning Area) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== TERRAIN TEST FEATURES ==================== -->

    <!-- 1. Low Step / Obstacle: +20 mm high (x = +0.8m, along +X forward path) -->
    <!-- Tests adaptive swing reflex and step height boost -->
    <model name="obstacle_step_20mm">
      <static>true</static>
      <pose>0.8 0.0 0.010 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.80 0.020</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.80 0.020</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.2 1</ambient>
            <diffuse>0.9 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. Trench / Step Down: 20 mm drop simulation (x = +1.5m) -->
    <!-- Tests downward foot probing and terrain adaptation -->
    <model name="depression_ditch_20mm">
      <static>true</static>
      <pose>1.5 0.0 0.0125 0 0 0</pose>
      <link name="link">
        <!-- Elevated platform after a 25mm ditch gap -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.50 0.80 0.025</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.50 0.80 0.025</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.2 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. Inclined Ramp: ~12° slope (x = 0.0m, y = +1.2m, along +Y lateral / angled path) -->
    <!-- Tests plane fitting, IMU gravity fusion and CoM shifting -->
    <!-- Ramp: length = 1.2m, pitch = 0.21 rad (~12°), elevated so bottom touches ground at z=0 -->
    <model name="plateau_access_ramp">
      <static>true</static>
      <pose>1.15 0.0 0.002 -0.10 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.25 0.80 0.020</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.25 0.80 0.020</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.8 1</ambient>
            <diffuse>0.2 0.6 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

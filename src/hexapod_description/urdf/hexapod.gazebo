<?xml version="1.0" ?>
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="body_color" value="Gazebo/Grey" />
  <xacro:property name="servo_color" value="Gazebo/DarkGrey" />

  <!-- Gazebo Sim system plugins -->
  <gazebo>
    <!-- Joint state publisher for Gazebo Sim (publishes all 18 joint positions) -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find hexapod_description)/config/hexapod_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <!-- self_collide disabled by default to prevent mesh-mesh penetration explosion in Gazebo/RL -->
    <self_collide>false</self_collide>
  </gazebo>

  <!-- Leg 0 Gazebo Properties -->
  <gazebo reference="leg_0_servo_1">
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_0_coxa">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_0_servo_2">
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_0_femur">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_0_servo_3">
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_0_tibia">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- Leg 1 Gazebo Properties -->
  <gazebo reference="leg_1_servo_1">
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_1_coxa">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_1_servo_2">
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_1_femur">
    <mu1>0.35</mu1>
    <mu2>0.35</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <gazebo reference="leg_1_servo_3">

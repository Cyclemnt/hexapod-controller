<?xml version="1.0"?>
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo Sim system plugins -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find hexapod_description)/config/hexapod_controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="base_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>false</self_collide>
  </gazebo>

  <!-- Leg Gazebo friction & collision parameters -->
  <xacro:macro name="hexapod_leg_gazebo" params="index">
    <gazebo reference="leg_${index}_coxa">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="leg_${index}_femur">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
      <self_collide>false</self_collide>
    </gazebo>

    <gazebo reference="leg_${index}_tibia">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <self_collide>false</self_collide>
    </gazebo>
  </xacro:macro>

  <xacro:hexapod_leg_gazebo index="0"/>
  <xacro:hexapod_leg_gazebo index="1"/>
  <xacro:hexapod_leg_gazebo index="2"/>
  <xacro:hexapod_leg_gazebo index="3"/>
  <xacro:hexapod_leg_gazebo index="4"/>
  <xacro:hexapod_leg_gazebo index="5"/>

</robot>
    <axis xyz="0 0 -1"/>
    <limit lower="${coxa_limit_lower}" upper="${coxa_limit_upper}" effort="${servo_effort}" velocity="${servo_velocity}"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <joint name="leg_5_femur_joint" type="revolute">
    <origin xyz="0.029396 -0.038849 -0.018004" rpy="0 0 0"/>
    <parent link="leg_5_coxa"/>
    <child link="leg_5_servo_2"/>
    <axis xyz="-0.5 -0.866025 0"/>
    <limit lower="${femur_limit_lower}" upper="${femur_limit_upper}" effort="${servo_effort}" velocity="${servo_velocity}"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <joint name="leg_5_servo_2_to_femur_joint" type="fixed">
    <origin xyz="0.008788 -0.001379 0.01025" rpy="0 0 0"/>
    <parent link="leg_5_servo_2"/>
    <child link="leg_5_femur"/>
  </joint>

  <joint name="leg_5_femur_to_servo_3_joint" type="fixed">
    <origin xyz="0.063426 -0.036734 0.0" rpy="0 0 0"/>
    <parent link="leg_5_femur"/>
    <child link="leg_5_servo_3"/>
  </joint>

  <joint name="leg_5_tibia_joint" type="revolute">
    <origin xyz="0.005638 -0.006835 -0.01025" rpy="0 0 0"/>
    <parent link="leg_5_servo_3"/>
    <child link="leg_5_tibia"/>
    <axis xyz="0.5 0.866025 0"/>
    <limit lower="${tibia_limit_lower}" upper="${tibia_limit_upper}" effort="${servo_effort}" velocity="${servo_velocity}"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <!-- ros2_control configuration -->
  <xacro:hexapod_ros2_control name="hexapod_hardware"/>

</robot>

<?xml version="1.0" ?>
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include modular components -->
  <xacro:include filename="$(find hexapod_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find hexapod_description)/urdf/hexapod.ros2_control.xacro" />
  <xacro:include filename="$(find hexapod_description)/urdf/hexapod.gazebo" />

  <!-- Actuator characteristics (Feetech STS3215-C018) -->
  <xacro:property name="servo_effort" value="3.0" />
  <xacro:property name="servo_velocity" value="5.8" />

  <!-- Joint limits in radians (TODO: Adjust per leg / mechanical stops if needed) -->
  <xacro:property name="coxa_limit_lower" value="-1.100" />
  <xacro:property name="coxa_limit_upper" value="1.100" />
  <xacro:property name="femur_limit_lower" value="-1.570" />
  <xacro:property name="femur_limit_upper" value="1.570" />
  <xacro:property name="tibia_limit_lower" value="-1.570" />
  <xacro:property name="tibia_limit_upper" value="1.500" />

  <!-- ==================== LINKS ==================== -->
    <!-- Base footprint: Dummy root link without inertia to satisfy KDL parser / REP-120 -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <!-- TODO: Replace with measured/calculated base_link mass and inertia matrix -->
      <mass value="1.820"/>
      <inertia ixx="0.005" iyy="0.005" izz="0.01" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hexapod_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
        <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Primitive box for DART physics engine stability and RL efficiency -->
        <box size="0.22 0.18 0.08"/>
      </geometry>
    </collision>
  </link>



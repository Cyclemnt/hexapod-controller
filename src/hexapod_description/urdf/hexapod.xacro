<?xml version="1.0"?>
<robot name="hexapod" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include modular components -->
  <xacro:include filename="$(find hexapod_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find hexapod_description)/urdf/hexapod.ros2_control.xacro" />
  <xacro:include filename="$(find hexapod_description)/urdf/hexapod.gazebo" />

  <!-- ==================== DIMENSIONS & PARAMETERS ==================== -->
  <!-- Chassis & leg kinematic dimensions (meters) -->
  <xacro:property name="coxa_mount_radius" value="0.133" />
  <xacro:property name="coxa_mount_z"      value="0.017546" />
  <xacro:property name="coxa_length"       value="0.045000" />
  <xacro:property name="femur_length"      value="0.090000" />
  <xacro:property name="tibia_foot_x"      value="0.019500" />
  <xacro:property name="tibia_foot_z"      value="-0.118405" />
  <xacro:property name="foot_radius"       value="0.005" />

  <!-- Actuator characteristics (Feetech STS3215-C018) -->
  <xacro:property name="servo_effort"   value="3.0" />
  <xacro:property name="servo_velocity" value="4.7" />
  <xacro:property name="joint_damping"  value="0.05" />
  <xacro:property name="joint_friction" value="0.02" />

  <!-- Joint limits (radians) -->
  <xacro:property name="coxa_limit_lower"  value="-1.100" />
  <xacro:property name="coxa_limit_upper"  value="1.100" />
  <xacro:property name="femur_limit_lower" value="-1.570" />
  <xacro:property name="femur_limit_upper" value="1.570" />
  <xacro:property name="tibia_limit_lower" value="-1.570" />
  <xacro:property name="tibia_limit_upper" value="1.570" />

  <!-- ==================== BASE LINKS ==================== -->
  <!-- Dummy root link without inertia to satisfy KDL parser / REP-120 -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Chassis + 6 fixed coxa servos (servo_1) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.002681" rpy="0 0 0"/>
      <mass value="2.15196"/>
      <inertia ixx="3.036e-3" iyy="2.991e-3" izz="5.680e-3" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <!-- Main chassis mesh -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://hexapod_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Simplified chassis cylinder collision -->
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.133" length="0.09"/>
      </geometry>
    </collision>

    <!-- 6 fixed coxa servos (servo_1, centered at coxa_mount_z) -->
    <xacro:macro name="base_servo_1" params="yaw">
      <visual>
        <origin xyz="${coxa_mount_radius * cos(yaw)} ${coxa_mount_radius * sin(yaw)} ${coxa_mount_z}"
                rpy="${pi / 2.0} 0 ${yaw}"/>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/st3215.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="${(coxa_mount_radius - 0.0124) * cos(yaw)} ${(coxa_mount_radius - 0.0124) * sin(yaw)} ${coxa_mount_z}"
                rpy="0 0 ${yaw}"/>
        <geometry>
          <box size="0.045 0.025 0.035"/>
        </geometry>
      </collision>
    </xacro:macro>

    <xacro:base_servo_1 yaw="${pi / 6.0}"/>
    <xacro:base_servo_1 yaw="${pi / 2.0}"/>
    <xacro:base_servo_1 yaw="${5.0 * pi / 6.0}"/>
    <xacro:base_servo_1 yaw="${-5.0 * pi / 6.0}"/>
    <xacro:base_servo_1 yaw="${-pi / 2.0}"/>
    <xacro:base_servo_1 yaw="${-pi / 6.0}"/>
  </link>

  <!-- ==================== LEG MACRO ==================== -->
  <!-- Local leg frame convention: +X = radially outward, +Y = tangential left, +Z = up -->
  <xacro:macro name="hexapod_leg" params="index yaw">

    <!-- 1. COXA LINK (coxa bracket only) -->
    <joint name="leg_${index}_coxa_joint" type="revolute">
      <origin xyz="${coxa_mount_radius * cos(yaw)} ${coxa_mount_radius * sin(yaw)} ${coxa_mount_z}"
              rpy="0 0 ${yaw}"/>
      <parent link="base_link"/>
      <child link="leg_${index}_coxa"/>
      <axis xyz="0 0 -1"/>
      <limit lower="${coxa_limit_lower}" upper="${coxa_limit_upper}" effort="${servo_effort}" velocity="${servo_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="leg_${index}_coxa">
      <inertial>
        <origin xyz="${coxa_length / 2.0} 0.0 0.0" rpy="0 0 0"/>
        <mass value="0.005428"/>
        <inertia ixx="1.0e-6" iyy="1.0e-6" izz="1.0e-6" ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
      <visual name="coxa_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/coxa.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision name="coxa_collision">
        <origin xyz="${coxa_length / 2.0} 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.066 0.042 0.042"/>
        </geometry>
      </collision>
    </link>

    <!-- 2. FEMUR LINK (femur bracket + servo_2 + servo_3) -->
    <joint name="leg_${index}_femur_joint" type="revolute">
      <origin xyz="${coxa_length} 0.0 0.0" rpy="0 0 0"/>
      <parent link="leg_${index}_coxa"/>
      <child link="leg_${index}_femur"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${femur_limit_lower}" upper="${femur_limit_upper}" effort="${servo_effort}" velocity="${servo_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="leg_${index}_femur">
      <inertial>
        <origin xyz="${femur_length / 2.0} 0.0 0.0" rpy="0 0 0"/>
        <mass value="0.12388"/>
        <inertia ixx="2.04e-5" iyy="1.48e-4" izz="1.54e-4" ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
      <visual name="femur_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/femur.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <visual name="servo_2_visual">
        <origin xyz="0 0 0" rpy="0 ${pi} 0"/>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/st3215.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <visual name="servo_3_visual">
        <origin xyz="${femur_length} 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/st3215.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision name="femur_collision">
        <origin xyz="${femur_length / 2.0} 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.080 0.035 0.031"/>
        </geometry>
      </collision>
      <collision name="servo_2_collision">
        <origin xyz="0.0124 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.035 0.025"/>
        </geometry>
      </collision>
      <collision name="servo_3_collision">
        <origin xyz="${femur_length - 0.0124} 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.045 0.035 0.025"/>
        </geometry>
      </collision>
    </link>

    <!-- 3. TIBIA LINK (tibia segment + point-contact foot sphere) -->
    <joint name="leg_${index}_tibia_joint" type="revolute">
      <origin xyz="${femur_length} 0.0 0.0" rpy="0 0 0"/>
      <parent link="leg_${index}_femur"/>
      <child link="leg_${index}_tibia"/>
      <axis xyz="0 1 0"/>
      <limit lower="${tibia_limit_lower}" upper="${tibia_limit_upper}" effort="${servo_effort}" velocity="${servo_velocity}"/>
      <dynamics damping="${joint_damping}" friction="${joint_friction}"/>
    </joint>

    <link name="leg_${index}_tibia">
      <inertial>
        <origin xyz="0.019 0.0 -0.025801" rpy="0 0 0"/>
        <mass value="0.01986"/>
        <inertia ixx="2.2e-5" iyy="2.4e-5" izz="5.0e-6" ixy="0.0" ixz="1.0e-6" iyz="0.0"/>
      </inertial>
      <visual name="tibia_visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://hexapod_description/meshes/tibia.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <!-- Knee clevis -->
      <collision name="leg_${index}_tibia_clevis_collision">
        <origin xyz="0.0225 0.0 -0.0010" rpy="0 0 0"/>
        <geometry>
          <box size="0.065 0.042 0.022"/>
        </geometry>
      </collision>
      <!-- Upper shank -->
      <collision name="leg_${index}_tibia_upper_collision">
        <origin xyz="0.0470 0.0 -0.0350" rpy="0 0.095 0"/>
        <geometry>
          <box size="0.0135 0.024 0.047"/>
        </geometry>
      </collision>
      <!-- Mid-lower shin -->
      <collision name="leg_${index}_tibia_mid_collision">
        <origin xyz="0.0385 0.0 -0.0731" rpy="0 0.397 0"/>
        <geometry>
          <box size="0.0115 0.017 0.0335"/>
        </geometry>
      </collision>
      <!-- Lower ankle -->
      <collision name="leg_${index}_tibia_lower_collision">
        <origin xyz="0.02585 0.0 -0.1033" rpy="0 0.397 0"/>
        <geometry>
          <cylinder radius="0.0052" length="0.0300"/>
        </geometry>
      </collision>
      <collision name="leg_${index}_tibia_foot_collision">
        <origin xyz="${tibia_foot_x} 0.0 ${tibia_foot_z}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${foot_radius}"/>
        </geometry>
      </collision>
    </link>

    <!-- 4. FOOT FRAME (foot sphere center) -->
    <joint name="leg_${index}_tibia_to_foot_joint" type="fixed">
      <origin xyz="${tibia_foot_x} 0.0 ${tibia_foot_z}" rpy="0 0 0"/>
      <parent link="leg_${index}_tibia"/>
      <child link="leg_${index}_foot"/>
    </joint>

    <link name="leg_${index}_foot"/>

  </xacro:macro>

  <!-- ==================== INSTANTIATE ALL 6 LEGS ==================== -->
  <xacro:hexapod_leg index="0" yaw="${pi / 6.0}"/>
  <xacro:hexapod_leg index="1" yaw="${pi / 2.0}"/>
  <xacro:hexapod_leg index="2" yaw="${5.0 * pi / 6.0}"/>
  <xacro:hexapod_leg index="3" yaw="${-5.0 * pi / 6.0}"/>
  <xacro:hexapod_leg index="4" yaw="${-pi / 2.0}"/>
  <xacro:hexapod_leg index="5" yaw="${-pi / 6.0}"/>

  <!-- ros2_control configuration -->
  <xacro:hexapod_ros2_control name="hexapod_hardware"/>

</robot>
<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="hexapod_ros2_control" params="name">
    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- Feetech STS3215 serial bus servo hardware interface / Gazebo simulation interface -->
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        <!-- For real hardware, replace with your custom Feetech hardware interface:
        <plugin>feetech_sts3215_hardware/STS3215HardwareInterface</plugin>
        -->
      </hardware>

      <xacro:macro name="leg_joint_control" params="leg_id joint_name">
        <joint name="${joint_name}">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:macro name="leg_control" params="leg_num">
        <xacro:leg_joint_control leg_id="${leg_num}" joint_name="leg_${leg_num}_coxa_joint"/>
        <xacro:leg_joint_control leg_id="${leg_num}" joint_name="leg_${leg_num}_femur_joint"/>
        <xacro:leg_joint_control leg_id="${leg_num}" joint_name="leg_${leg_num}_tibia_joint"/>
      </xacro:macro>

      <xacro:leg_control leg_num="0"/>
      <xacro:leg_control leg_num="1"/>
      <xacro:leg_control leg_num="2"/>
      <xacro:leg_control leg_num="3"/>
      <xacro:leg_control leg_num="4"/>
      <xacro:leg_control leg_num="5"/>
    </ros2_control>
  </xacro:macro>

</robot>
